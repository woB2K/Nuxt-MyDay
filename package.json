    "@nuxtjs/i18n": "^10.3.0",
    "@pinia/nuxt": "0.11.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/vue-query": "^5.100.11",
    "@tanstack/vue-query-devtools": "^6.1.30",
    "@vite-pwa/nuxt": "1.1.1",
    "bcrypt": "^6.0.0",
    "jose": "^6.2.3",
    "nuxt": "^4.4.2",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@nuxt/eslint": "^1.15.2",
