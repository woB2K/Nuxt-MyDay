# Copy to .env, or let scripts/selfhost/init-env.sh fill it with fresh secrets.

MYDAY_VERSION=latest
NUXT_PUBLIC_APP_URL=https://myday.example.com

POSTGRES_USER=myday
POSTGRES_PASSWORD=
POSTGRES_DB=myday

NUXT_JWT_ACCESS_SECRET=
NUXT_JWT_REFRESH_SECRET=

# false: only the first account and people with a family invite can sign up
ALLOW_REGISTRATION=false

# caddy — HTTPS for MYDAY_DOMAIN on ports 80/443; backup — nightly backup to Google Drive
COMPOSE_PROFILES=caddy
MYDAY_DOMAIN=myday.example.com

APP_BIND=127.0.0.1
APP_PORT=3000

# Proxies in front of the app: 1 for Caddy or nginx, 2 for Cloudflare → nginx
NUXT_PROXY_HOPS=1
NUXT_CLIENT_IP_HEADER=

NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

BACKUP_PASSWORD=
BACKUP_PING_URL=
BACKUP_SCHEDULE='0 1 * * *'
BACKUP_REPOSITORY=rclone:gdrive:myday-backup

# Build the images from this checkout instead of pulling them
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
