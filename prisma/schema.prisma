datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = ".generated/prisma"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]
  settings      AppSettings?
  tasks         Task[]
  templates     TaskTemplate[]
  tags          Tag[]
  transactions  Transaction[]
  savings       SavingsEntry[]
  categories    Category[]
  budgets       Budget[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AppSettings {
  id         String   @id @default(cuid())
  userId     String   @unique
  theme      String   @default("dark")
  accent     String   @default("#A78BFA")
  lang       String   @default("en")
  pinEnabled Boolean  @default(false)
  pinHash    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  notes     String?
  done      Boolean   @default(false)
  doneAt    DateTime?
  priority  Priority  @default(NONE)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id])
  tags TaskTag[]
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model TaskTemplate {
  id        String   @id @default(cuid())
  userId    String
  title     String
  notes     String?
  priority  Priority @default(NONE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User              @relation(fields: [userId], references: [id])
  tags TaskTemplateTag[]
}

model TaskTemplateTag {
  templateId String
  tagId      String

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag      Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id])
  tasks     TaskTag[]
  templates TaskTemplateTag[]

  @@unique([userId, name])
}

model Transaction {
  id         String          @id @default(cuid())
  userId     String
  type       TransactionType
  amount     Decimal         @db.Decimal(12, 2)
  categoryId String
  notes      String?
  date       DateTime        @db.Date
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
}

model SavingsEntry {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  type      SavingsType
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  name      String
  icon      String
  color     String
  type      TransactionType
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(12, 2)
  month      DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month])
}

enum Priority {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum SavingsType {
  DEPOSIT
  WITHDRAWAL
}
